# Opcional — só necessário para redação das respostas por IA.
# Sem nenhuma chave, o programa funciona 100% offline (busca local + citações literais).

# OpenAI (prioridade 1)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (prioridade 2, usado se OpenAI ausente/falhar)
GEMINI_API_KEY=
# ou GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama local (prioridade quando --local / checkbox da web; nada vai p/ nuvem)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b   # vazio = usa o 1º modelo instalado
# OLLAMA_TIMEOUT=180

# Flask
FLASK_SECRET_KEY=troque-esta-chave-em-producao
